# ---------------------------------------------------------------------------
# Yomi environment configuration (template)
# Copy to .env and adjust before any deployment.
# docker compose automatically reads .env.
# ---------------------------------------------------------------------------

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=yomi
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=yomi_auth
POSTGRES_PORT=5432

# --- Redis ------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# --- Kafka (KRaft) ----------------------------------------------------------
KAFKA_BROKER_ID=1
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9093
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:9092,CONTROLLER://0.0.0.0:9093
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
KAFKA_NUM_PARTITIONS=3

# --- JWT keys ---------------------------------------------------------------
# PEM files generated by scripts/gen-keys.sh into ./keys
JWT_PRIVATE_KEY_PATH=/keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/keys/jwt-public.pem
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# --- Consent access tokens ---------------------------------------------------
# Access tokens are opaque random values. Only a SHA-256 hash is stored, so
# there is no signing secret. This TTL bounds the revocation marker in Redis.
CONSENT_TOKEN_TTL=24h

# --- Citizen receipt signing -------------------------------------------------
# HMAC secret for the tamper-evident receipt a citizen is handed on approval.
# Held by the consent and audit services only. Must match across both.
RECEIPT_SECRET=CHANGE_ME_RECEIPT_SIGNING_SECRET

# --- Internal service-to-service secret --------------------------------------
INTERNAL_SERVICE_SECRET=CHANGE_ME_INTERNAL_SECRET

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40

# --- CORS --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Cookies -----------------------------------------------------------------
REFRESH_COOKIE_NAME=yomi_refresh
REFRESH_COOKIE_DOMAIN=
